spring.application.name=CasaAutomatica

spring.datasource.url=jdbc:mysql://localhost:3306/CasaAutomatica
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
server.port=8000

springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true

# Mínimo: senha com 12+ caracteres; chave do ESP32 com 32+ caracteres
casa-automatica.security.user.name=admin
casa-automatica.security.user.password=CHANGE_ME_MIN_12_CHARS
casa-automatica.security.device-api-key=CHANGE_ME_DEVICE_KEY_MIN_32_CHARACTERS_LONG
casa-automatica.security.rate-limit.requests-per-minute=120

casa-automatica.security.alexa-skill-id=${CASA_AUTOMATICA_ALEXA_SKILL_ID:}

